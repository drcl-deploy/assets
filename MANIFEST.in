include LICENSE
include THIRD_PARTY_NOTICES.md
include readme.md
recursive-include docs *.md
recursive-include src/assets *.json *.md *.mtl *.obj *.png *.PNG *.psd *.stl *.STL *.urdf *.xml
recursive-exclude src/assets/omomo_objects *.urdf *_cvx_*.xml
recursive-exclude src/assets/sugar_objects *.urdf *_cvx_*.xml
recursive-exclude src/assets/custom_objects *.urdf *_cvx_*.xml
prune src/assets/omni_objects/scenes
global-exclude *.py[cod]
global-exclude __pycache__
