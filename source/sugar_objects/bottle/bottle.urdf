<?xml version="1.0"?>
<robot name="bottle">

  <link name="base_link">
    
    <inertial>
       <mass value="0.70000"/>
      <inertia ixx="0.015441" ixy="-0.000240" ixz="0.000112" iyy="0.010247" iyz="0.002701" izz="0.014075"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="bottle.obj"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="bottle.obj"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.6</mu>
            <mu2>0.6</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
            <max_vel>100.0</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>
    
  </link>
</robot>
