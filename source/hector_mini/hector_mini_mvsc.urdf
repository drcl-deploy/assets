      <geometry>
        <cylinder radius ="0.04" length="0.035"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_hip_pitch_joint" type="revolute">
    <origin xyz="0.04875 0.0155 0" rpy="0 -0.7853981 0"/>
    <parent link="left_hip2"/>
    <child link="left_hip_pitch_joint"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1" upper="2.57" effort="17" velocity="22"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <link name="left_hip_pitch_joint">
