<?xml version="0.0" ?>
<robot name="hector_mini">
  <mujoco>
    <compiler meshdir="./meshes/" discardvisual="false"/>
  </mujoco>
  <!-- Base link -->
  <link name="body">
    <inertial>
      <origin xyz="0.031602 0.0 -0.022894" rpy="0 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.008616" iyy="0.009058" izz="0.005317" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/body2.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.037 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.148 0.135 0.19"/>
      </geometry>
    </collision>
    <!-- Can probably comment this out -->
    <collision>
      <origin xyz="0.03 0 -0.09" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.18"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_hip_yaw_joint" type="revolute">
    <origin xyz="0 0.05 -0.125" rpy="0 0.7853981 0"/>
    <parent link="body"/>
    <child link="left_hip1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="17" velocity="22"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <!-- Left Hip Yaw -->
  <link name="left_hip1">
    <inertial>
      <origin xyz="-0.0107 0 -0.0455" rpy="0 0 0"/>
      <mass value="0.385"/>
      <inertia ixx="0.00023228" iyy="0.00017208" izz="0.00012534" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/hip_short_1.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.045" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius ="0.044" length="0.035"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_hip_roll_joint" type="revolute">
    <origin xyz="0.0155 0 -0.04875" rpy="0 0 0"/>
    <parent link="left_hip1"/>
    <child link="left_hip2"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="1.0" effort="17" velocity="22"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <!-- Left Hip Roll -->
