<mujoco model="rocky_ground">

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="120" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="rockyplane" file="rocky_texture.png"/>
        <material name="rockyplane" texture="rockyplane" texuniform="true" texrepeat="5 5" reflectance="0.8"/>
        <hfield name="hfield" file="hfield.png" size="10 10 0.1 1.0"/>
    </asset>

    <worldbody>
        <geom name="floor"
              type="hfield"
              hfield="hfield"
              material="rockyplane"
              friction="1 0.01 0.001"
              solref="0.01 1"
              solimp="0.9 0.95 0.001"/>
    </worldbody>

</mujoco>
