<?xml version="1.0"?>
<robot name="basketball">

  <link name="base_link">

    <inertial>
      <mass value="0.62369"/>
      <inertia ixx="0.003592" ixy="0.000000" ixz="0.000000" iyy="0.003592" iyz="0.000000" izz="0.003592"/>
    </inertial>

    <visual>
      <geometry>
        <sphere radius="0.12"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.12"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.6</mu>
            <mu2>0.6</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
            <max_vel>100.0</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>

  </link>
</robot>
