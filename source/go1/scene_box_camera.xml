<mujoco model="scene_box_camera">
  <include file="go1.xml"/>
  <include file="../box/boxes.xml"/>

  <statistic center="0 0 0.25" extent="1"/>

  <visual>
    <headlight diffuse="0 0 0" ambient="0 0 0" specular="0 0 0"/>
    <rgba haze="0 0 0 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.45 0.60 0.85"   
             rgb2="0.20 0.36 0.55"  
             width="512" height="3072"/>
    <texture name="black_grid" type="2d" builtin="checker"
             rgb1="0.08 0.08 0.08"
             rgb2="0.13 0.13 0.13"
             width="32" height="32"/>
    <material name="black_tiles"
              texture="black_grid"
              texrepeat="16 16"
              reflectance="0.08"
              rgba="1 1 1 1"/>
  </asset>

  <worldbody>
    <light name="sun" directional="true"
           diffuse="1.1 1.08 1.0"
           ambient="0.45 0.5 0.75"
           pos="0 0 6"
           dir="0 0 -1"
           castshadow="true"/>

    <geom name="floor" size="0 0 .125" type="plane"
          material="black_tiles"
          friction="1 0.005 0.0001"
          conaffinity="15" condim="3" />
  </worldbody>
</mujoco>
