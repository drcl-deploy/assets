<?xml version="1.0"?>
<robot name="woodchair">

  <link name="base_link">

    <inertial>
      <mass value="4.50000"/>
      <inertia ixx="0.179987" ixy="0.004610" ixz="-0.021277" iyy="0.183291" iyz="0.014878" izz="0.096894"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="woodchair.obj"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="woodchair.obj"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.6</mu>
            <mu2>0.6</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
            <max_vel>100.0</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>

  </link>
</robot>
