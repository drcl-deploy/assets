<?xml version="1.0"?>
<robot name="largebox">

  <link name="base_link">

    <inertial>
      <mass value="4.50000"/>
      <inertia ixx="0.085918" ixy="0.001641" ixz="0.002006" iyy="0.086162" iyz="-0.000693" izz="0.079003"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="largebox.obj"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="largebox.obj"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.6</mu>
            <mu2>0.6</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
            <max_vel>100.0</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>

  </link>
</robot>
