<?xml version="1.0"?>
<robot name="trashcan">

  <link name="base_link">

    <inertial>
      <mass value="0.80000"/>
      <inertia ixx="0.011799" ixy="-0.000503" ixz="-0.001439" iyy="0.008060" iyz="-0.000071" izz="0.012233"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="trashcan.obj"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="trashcan.obj"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.6</mu>
            <mu2>0.6</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
            <max_vel>100.0</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>

  </link>
</robot>
