<?xml version="1.0"?>
<robot name="tripod">

  <link name="base_link">

    <inertial>
      <mass value="0.80000"/>
      <inertia ixx="0.056916" ixy="0.057735" ixz="0.003754" iyy="0.073599" iyz="-0.003243" izz="0.123445"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="tripod.obj"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="tripod.obj"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.6</mu>
            <mu2>0.6</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
            <max_vel>100.0</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>

  </link>
</robot>
