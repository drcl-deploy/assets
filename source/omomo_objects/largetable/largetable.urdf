<?xml version="1.0"?>
<robot name="largetable">

  <link name="base_link">

    <inertial>
      <mass value="4.50000"/>
      <inertia ixx="0.117365" ixy="-0.000000" ixz="0.000000" iyy="0.140171" iyz="0.000000" izz="0.117365"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="largetable.obj"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="largetable.obj"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.6</mu>
            <mu2>0.6</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
            <max_vel>100.0</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>

  </link>
</robot>
