<?xml version="1.0"?>
<robot name="whitechair">

  <link name="base_link">

    <inertial>
      <mass value="1.50000"/>
      <inertia ixx="0.038563" ixy="-0.001392" ixz="-0.012264" iyy="0.051533" iyz="0.000717" izz="0.041607"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="whitechair.obj"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="whitechair.obj"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.6</mu>
            <mu2>0.6</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
            <max_vel>100.0</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>

  </link>
</robot>
